# CDK auto-resolved context (AZ/SSM lookups; regenerated as needed)
infrastructure/cdk.context.json

# Publisher trust anchor — the REAL anchor (real publisher AID + real witness
# OOBI domains) is build-injected, never committed. Only the placeholder
# `publisher_anchor.example.json` template is tracked. CI/build writes the real
# file here or points $LOCKSMITH_PUBLISHER_ANCHOR at it. See
# locksmith.update.cli._load_publisher_anchor.
src/locksmith/release/publisher_anchor.json

# Deploy config — the REAL federation/CDN domains (witness hosts/AIDs +
# releases CDN base/bucket + appcast URLs) live here and are never committed.
# Only the placeholder `deploy_config.example.json` template is tracked.
# CI/build writes the real file here or points $LOCKSMITH_DEPLOY_CONFIG at it.
# See locksmith.release.deploy.load_deploy_config.
src/locksmith/release/deploy_config.json

# Runtime brand config — generated by scripts/brand_apply.py from the active
# brand's brand.toml. The committed default lives in code
# (locksmith.core.branding._DEFAULT == the Locksmith reference brand); a
# white-label build writes this file to override it. Never committed.
# See locksmith.core.branding.load_brand.
src/locksmith/release/brand.json

# Per-brand trust material — the REAL publisher anchor + deploy_config for each
# brand carry real AIDs/federation domains and are never committed. Only
# brands/example/*.example.json placeholders and brands/<brand>/brand.toml
# (non-secret identity) are tracked. See docs/superpowers/specs/2026-06-23-*.
brands/*/publisher_anchor.json
brands/*/deploy_config.json

# Publisher anchor scratch dir — `locksmith-publisher anchor --output-dir ./out`
# writes DMG/MSI + release-anchor cesr/receipts locally before uploading to S3.
# The canonical copies live on S3; locally they're throwaway.
/out/
